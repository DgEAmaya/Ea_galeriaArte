<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Admin' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white">

  <% if (typeof showMenu === 'undefined' || showMenu) { %>
    <!-- Sidebar fijo -->
    <aside class="fixed top-0 left-0 h-screen w-64 bg-zinc-950 border-r border-zinc-800 flex flex-col p-4 z-50">
      <%- include('partials/menu') %>
    </aside>
  <% } %>

  <!-- Contenedor principal con margen para dejar espacio al sidebar -->
  <div class="<%= (typeof showMenu === 'undefined' || showMenu) ? 'ml-64' : '' %> min-h-screen p-6">
    <main>
      <%- body %>
    </main>
  </div>

</body>
</html>
