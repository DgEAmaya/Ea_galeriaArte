<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-zinc-900 text-white">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-zinc-950 border-r border-zinc-800 flex flex-col p-4">
        <h2 class="text-xl font-bold mb-6">Admin Panel</h2>
        <nav class="flex-1 space-y-2">
          <a href="/admin/dashboard" class="block px-4 py-2 rounded hover:bg-zinc-800">Inicio</a>
          <a href="/admin/menus" class="block px-4 py-2 rounded hover:bg-zinc-800">Menús</a>
          <a href="/admin/pinturas" class="block px-4 py-2 rounded hover:bg-zinc-800">Pinturas</a>
        </nav>
        <form action="/admin/logout" method="POST">
          <button class="mt-4 w-full bg-red-600 hover:bg-red-700 px-4 py-2 rounded">Cerrar sesión</button>
        </form>
      </aside>

      <!-- Main content -->
      <main class="flex-1 p-6 overflow-auto">
        <%- body %>
      </main>
    </div>
  </body>
</html>
